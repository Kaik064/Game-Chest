PORT=3000
DB_HOST=seu-endpoint.tidbcloud.com
DB_PORT=4000
DB_USER=usuario-com-prefixo
DB_PASS=preencha-localmente
DB_NAME=seu_schema
# DB_SSL_CA_PATH=C:/caminho/para/ca.pem

# Fuso usado para devolver as datas da API (ISO 8601 com offset)
APP_TIMEZONE=America/Sao_Paulo

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Sessão de login (JWT + cookie httpOnly). Gere um valor aleatório longo.
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL pública desta API (usada no retorno do OpenID da Steam)
PUBLIC_API_URL=http://localhost:3000

# URL do front-end para onde o vínculo Steam redireciona
FRONTEND_URL=http://localhost:5173

# Cookie: em produção (HTTPS) use COOKIE_SECURE=true.
# Em front/back em domínios diferentes, use COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Necessário para ler a biblioteca/horas da Steam (busca de catálogo não usa).
# Obtenha em https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
